{
  "name": "ebook",
  "private": true,
  "description": "EBook 电子书城 — 根目录便捷脚本，实际前端工程在 ebook-frontend/",
  "scripts": {
    "dev": "npm run dev --prefix ebook-frontend",
    "dev:assistant": "./ebook-agent/run-local.sh",
    "dev:backend": "./ebook-backend/run-local.sh",
    "build": "npm run build --prefix ebook-frontend",
    "preview": "npm run preview --prefix ebook-frontend",
    "install:frontend": "npm install --prefix ebook-frontend",
    "test:assistant": "python3 -m pytest ebook-agent/backend/tests -q"
  }
}
