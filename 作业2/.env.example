# 复制成 .env 后填写即可，不必每次 export。
#
#   cp .env.example .env
#
# 已经存在的环境变量优先于本文件，所以临时覆盖可以直接：
#   LLM_MODEL=gpt-4o ./run-local.sh
#
# 不填 LLM_API_KEY 时会使用内置的离线替身模型，功能完整、不联网，适合先跑通流程。

# ---- 大模型接口（任何 OpenAI 兼容服务都可以）----
#
# LLM_BASE_URL 填到服务根 + /v1 为止，**不要**带 /chat/completions ——
# 客户端会自己拼这一段，多写了会变成 .../chat/completions/chat/completions 而返回 404。
# （程序会把误写的后缀自动去掉，但填对更省事。）

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxxx

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx

# 通义千问（兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-xxxx

# 上海交大模型服务
# LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# 模型请求超时（秒）
LLM_TIMEOUT_SECONDS=30
# 采样温度
LLM_TEMPERATURE=0.2

# ---- 库存数据源 ----
# 留空时 check_inventory 读内置的模拟目录（与 data.sql 演示数据一致）。
# 设置后改读电子书城真实后端，例如：
# BOOKSTORE_API_BASE=http://localhost:8080
BOOKSTORE_API_BASE=

# ---- 模拟竞品比价接口的行为 ----
# 单次调用耗时（秒）
COMPETITOR_LATENCY_SECONDS=0.4
# 超过这个耗时即判定为上游超时
COMPETITOR_TIMEOUT_SECONDS=1.0

# ---- Function Calling 循环的刹车 ----
# 单轮提问内最多几次「模型 → 工具 → 模型」往返
AGENT_MAX_TOOL_ROUNDS=6
# 连续工具失败多少次后中止，返回兜底话术
AGENT_MAX_TOOL_ERRORS=3

# ---- 跨域白名单（逗号分隔）----
# 走 Vite 代理时用不到；直连助手服务时需要。留空则用回环地址 × 5173/4173 的默认值。
# ASSISTANT_ALLOWED_ORIGINS=http://localhost:5173
