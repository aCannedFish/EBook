# 复制成 .env 即可生效（.env 不进版本库，也不会进提交压缩包）。
# 环境变量优先于本文件：临时换模型不必改文件，
#   LLM_MODEL=deepseek-chat python3 -m backend.cli --remote

# ---------- 对话模型（ReAct 循环用的就是它）----------
# 任意 OpenAI 兼容接口，填到 /v1 为止，不要带 /chat/completions。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# 国内可用的几家写法：
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
#   通义千问   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#              LLM_MODEL=qwen-plus
#   课程网关   LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1  LLM_MODEL=deepseek-chat

# ---------- 向量化 ----------
# local（默认）：本地 BGE 中文语义 Embedding，首次运行下载模型权重。
# offline：TF-IDF 词法向量，仅用于无模型下载的测试。
# remote：远程 /embeddings，失败即报错。
# auto：尝试远程，失败回退 TF-IDF，实际模式写入日志。
EMBEDDING_MODE=local
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=0
EMBEDDING_BATCH_SIZE=32

# ---------- RAG ----------
RAG_CORPUS_PATH=data/policy.txt
RAG_CHUNK_SIZE=420
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=3
# BGE 演示使用 0.55。TF-IDF 测试模式请改为 0.12；不同模型需重新校准。
RAG_MIN_SCORE=0.55
RAG_USE_CACHE=1

# ---------- ReAct 循环 ----------
AGENT_MAX_STEPS=6
AGENT_MAX_CONSECUTIVE_ERRORS=3
AGENT_OBSERVATION_MAX_CHARS=3000

# ---------- 模拟书目检索 ----------
CATALOG_DEFAULT_LIMIT=3
CATALOG_MAX_LIMIT=10
# 书目检索的命中质量闸门：低于该值的书不算命中，避免给出沾边的结果。
CATALOG_MIN_SCORE=1.0
